SEO_APP_ENV=development
SEO_DATABASE_PATH=seo_monitor.db
SEO_REQUEST_TIMEOUT_SECONDS=20
SEO_MAX_RESPONSE_BYTES=5000000
SEO_MAX_RETRIES=2
SEO_RETRY_BACKOFF_SECONDS=0.25
SEO_MAX_CRAWL_PAGES=25
SEO_CRAWL_CONCURRENCY=5
SEO_MONITOR_POLL_SECONDS=60
SEO_ALLOW_PRIVATE_HOSTS=false
SEO_LOG_LEVEL=INFO
# SEO_API_KEY=replace-with-a-long-random-value
# SEO_CORS_ORIGINS=https://dashboard.example.com
# SEO_WEBHOOK_URL=https://hooks.example.com/seo
# SEO_WEBHOOK_SECRET=replace-with-an-independent-signing-secret
SEO_WEBHOOK_TIMEOUT_SECONDS=10
# SEO_GSC_CREDENTIALS_FILE=/run/secrets/gsc-credentials.json

